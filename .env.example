# Copy to .env for local overrides. Never commit .env.
# Defaults below match docker-compose.yml local-only credentials.

# Domain Postgres (IncidentPilot)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=incidentpilot
POSTGRES_PASSWORD=incidentpilot
POSTGRES_DB=incidentpilot

# App / runner / evaluator / migrator roles (created by make migrate)
IP_APP_PASSWORD=incidentpilot_app
IP_RUNNER_PASSWORD=incidentpilot_runner
IP_EVALUATOR_PASSWORD=incidentpilot_evaluator
MIGRATOR_PASSWORD=incidentpilot_migrator

DATABASE_URL=postgresql://ip_app:incidentpilot_app@localhost:5432/incidentpilot
DATABASE_URL_RUNNER=postgresql://ip_runner:incidentpilot_runner@localhost:5432/incidentpilot
DATABASE_URL_EVALUATOR=postgresql://ip_evaluator:incidentpilot_evaluator@localhost:5432/incidentpilot
DATABASE_URL_MIGRATOR=postgresql://migrator:incidentpilot_migrator@localhost:5432/incidentpilot

# MinIO / Silo (local only — not production secrets). G5 RAW evidence uploads
# use S3_ENDPOINT + S3_BUCKET_EVIDENCE; when the store is down collectors still
# write Evidence as MEDIUM RAW (hash + external_ref) — never fake HIGH.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_EVIDENCE=incidentpilot-evidence
S3_BUCKET_AI_ARTIFACTS=incidentpilot-ai-artifacts
S3_BUCKET_POSTMORTEM_EXPORTS=incidentpilot-postmortem-exports
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Temporal (local)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_UI_URL=http://localhost:8088

# Web dashboard (M1) — deep links + browser CORS
INCIDENTPILOT_WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_MODE=stub

# LLM (H1) — general incidentpilot-worker only; never evidence-/remediation-worker.
LLM_PROVIDER=fake
LLM_MODEL=fake-test
# OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=

# Redis is optional (compose profile `redis`) and cache-only — never SoR.

# Observability stack (compose profile `evidence` / E3) — local only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_URL=http://localhost:3000
# Evidence-worker only (G3/G7) — never inject into the general worker process.
# GENERAL_FORBIDDEN_ENV = PROMETHEUS_URL / LOKI_URL / TEMPO_URL
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200

# Alertmanager webhook ingress (F1) — set at least one auth mechanism
ALERTMANAGER_WEBHOOK_TOKEN=dev-am-webhook-token
# ALERTMANAGER_BASIC_USER=am
# ALERTMANAGER_BASIC_PASSWORD=changeme
# ALERTMANAGER_HEADER_NAME=X-Alertmanager-Token
# ALERTMANAGER_HEADER_VALUE=
