# Copy to terraform.tfvars for a real staging apply (never commit secrets).
# O8 ephemeral path: docs/staging-eks.md — apply → smoke → destroy same day.

aws_region  = "us-east-1"
name_prefix = "ip-staging-YOURUNIQUE"

# Staging Multi-AZ shape
azs                  = ["us-east-1a", "us-east-1b"]
vpc_cidr             = "10.40.0.0/16"
public_subnet_cidrs  = ["10.40.0.0/24", "10.40.1.0/24"]
private_subnet_cidrs = ["10.40.10.0/24", "10.40.11.0/24"]

kubernetes_version = "1.29"
db_username        = "ip_migrator"

# false = cheap IAM/Secrets/IRSA skeleton only.
# true  = VPC/EKS/RDS/S3 (costly) — tear down after make staging-eks-smoke.
enable_expensive_resources = false
