{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "IncidentPilot Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": ["global", "namespace", "evalNamespace", "serviceAccounts", "irsa", "api", "worker", "evidenceWorker", "remediation", "web", "evaluator", "scenarioRunner", "config", "ingress"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "imageRegistry", "imagePullPolicy"],
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["local", "staging", "production-demo"]
        },
        "imageRegistry": { "type": "string", "minLength": 1 },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "evalNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "api", "worker", "evidence", "remediation", "evaluator", "runner", "web"],
      "properties": {
        "create": { "type": "boolean" },
        "api": { "type": "string", "minLength": 1 },
        "worker": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "evaluator": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "web": { "type": "string", "minLength": 1 }
      }
    },
    "irsa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "roleArns"],
      "properties": {
        "enabled": { "type": "boolean" },
        "roleArns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "worker", "evidence", "remediation", "evaluator", "runner", "web"],
          "properties": {
            "api": { "type": "string" },
            "worker": { "type": "string" },
            "evidence": { "type": "string" },
            "remediation": { "type": "string" },
            "evaluator": { "type": "string" },
            "runner": { "type": "string" },
            "web": { "type": "string" }
          }
        }
      }
    },
    "api": { "$ref": "#/definitions/component" },
    "worker": { "$ref": "#/definitions/component" },
    "evidenceWorker": { "$ref": "#/definitions/component" },
    "remediation": { "$ref": "#/definitions/component" },
    "web": { "$ref": "#/definitions/component" },
    "evaluator": { "$ref": "#/definitions/component" },
    "scenarioRunner": { "$ref": "#/definitions/component" },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseSecretName", "temporalHost", "temporal", "logLevel"],
      "properties": {
        "databaseSecretName": { "type": "string", "minLength": 1 },
        "temporalHost": { "type": "string", "minLength": 1 },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hosting", "address", "namespace", "tls"],
          "properties": {
            "hosting": {
              "type": "string",
              "enum": ["cloud", "selfhosted"]
            },
            "address": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 },
            "tls": { "type": "boolean" },
            "apiKeySecretName": { "type": "string" },
            "apiKeySecretKey": { "type": "string" }
          }
        },
        "s3Endpoint": { "type": "string" },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warning", "error"]
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "user", "webhooks"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "user": { "$ref": "#/definitions/ingressPlane" },
        "webhooks": { "$ref": "#/definitions/ingressPlane" }
      }
    }
  },
  "definitions": {
    "ingressPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "hosts"],
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hosts", "secretName"],
            "properties": {
              "hosts": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "secretName": { "type": "string", "minLength": 1 }
            }
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "service", "port"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "pathType": {
                      "type": "string",
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                    },
                    "service": { "type": "string", "minLength": 1 },
                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number"] }
        },
        "limits": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number"] }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "resources": { "$ref": "#/definitions/resources" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    }
  }
}

