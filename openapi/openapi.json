    "/webhooks/alerts/alertmanager": {
      "post": {
        "tags": [
          "webhooks"
        ],
        "summary": "Alertmanager webhook ingress",
        "description": "Accept an Alertmanager webhook payload.\n\nAuth: Bearer / Basic / custom header (see docs/alert-webhooks.md).\nReplay: ``Idempotency-Key`` or ``X-Request-Id``, else SHA-256 of body.\nDuplicate keys return **200** with ``status=duplicate`` (success/no-op).\nF2: normalize each alert, upsert ``domain.alert`` by IncidentPilot fingerprint.",
        "operationId": "alertmanager_webhook_webhooks_alerts_alertmanager_post",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Request-Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertIngressAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "incident_id": {
            "type": "string",
            "format": "uuid",
            "title": "Incident Id"
          },
          "action_type": {
            "type": "string",
            "title": "Action Type"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "current_version": {
            "type": "integer",
            "title": "Current Version"
          },
          "is_reversible": {
            "type": "boolean",
            "title": "Is Reversible"
          }
        },
        "type": "object",
        "required": [
          "id",
          "incident_id",
          "action_type",
          "status",
          "current_version",
          "is_reversible"
        ],
        "title": "ActionOut"
      },
      "AlertIngressAccepted": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "accepted | duplicate"
          },
          "ingress_id": {
            "type": "string",
            "title": "Ingress Id"
          },
          "idempotent": {
            "type": "boolean",
            "title": "Idempotent",
            "default": false
          },
          "alert_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Alert Ids"
          },
          "fingerprints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fingerprints"
          }
        },
        "type": "object",
        "required": [
          "status",
          "ingress_id"
        ],
        "title": "AlertIngressAccepted"
      },
      "AlertOut": {
        "properties": {
